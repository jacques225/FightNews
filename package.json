{
  "name": "fightnews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pipeline": "tsx --env-file-if-exists=.env.local pipeline/run.ts",
    "pipeline:dry": "tsx --env-file-if-exists=.env.local pipeline/run.ts --dry-run",
    "sources:check": "tsx pipeline/check-sources.ts",
    "calendar:check": "tsx pipeline/calendar-check.ts",
    "newsletter": "tsx --env-file-if-exists=.env.local pipeline/newsletter.ts",
    "newsletter:preview": "tsx --env-file-if-exists=.env.local pipeline/newsletter.ts --dry-run",
    "test": "node --import tsx --test pipeline/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.30.0",
    "rss-parser": "^3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
