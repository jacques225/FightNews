{
  "mcpServers": {
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      }
    },
    "inspo": {
      "type": "http",
      "url": "https://inspomcp.dev/api/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    }
  }
}
