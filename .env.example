# Supabase (Project settings > API Keys)
# Clé publique : "anon" ou "publishable" selon l'ancienneté du projet
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète ("service_role" ou "secret") : côté serveur uniquement (robot, routes de la newsletter).
# Ne jamais la mettre dans une variable qui commence par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Aucun fournisseur IA ni clé OpenAI/Anthropic nécessaire pour les flux RSS.

# "draft" = tu valides chaque article avant publication ; "published" = publication automatique
PIPELINE_DEFAULT_STATUS=draft

# Adresse publique du site, utilisée dans les liens des e-mails
SITE_URL=http://localhost:3000

# Newsletter (resend.com) : clé d'API et expéditeur sur ton domaine vérifié
RESEND_API_KEY=re_...
NEWSLETTER_FROM=FightNews <newsletter@ton-domaine.fr>
