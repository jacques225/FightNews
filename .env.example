# Supabase (Project settings > API Keys)
# Clé publique : "anon" ou "publishable" selon l'ancienneté du projet
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète ("service_role" ou "secret") : uniquement pour le pipeline (GitHub Actions), jamais sur Vercel
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# IA (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5

# "draft" = tu valides chaque article avant publication ; "published" = publication automatique
PIPELINE_DEFAULT_STATUS=draft
